  "main": "index.js",
  "scripts": {
    "install:node" : "npm ci --prefix src/functions/create-upload & npm ci --prefix src/functions/get-image",

    "test:create-upload": "npm --prefix src/functions/create-upload test",
    "test:get-image": "npm --prefix src/functions/get-image test",
    "test:node": "npm run test:create-upload && npm run test:get-image",

    "build:create-upload": "npm --prefix src/functions/create-upload run build",
    "build:get-image": "npm --prefix src/functions/get-image run build",
    "build:node": "npm run build:create-upload && npm run build:get-image",

    "test": "npm run test:node",
    "build": "npm run build:node"
  },
